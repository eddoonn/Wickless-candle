//@version=6
strategy(
     title = "No Wick EMA Origin-Limit Strategy 15m",
     shorttitle = "No Wick Origin 15m",
     overlay = true,
     initial_capital = 50000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 1,
     pyramiding = 0,
     commission_type = strategy.commission.cash_per_order,
     commission_value = 0,
     slippage = 1,
     process_orders_on_close = false,
     calc_on_every_tick = false,
     calc_on_order_fills = true
)

// Shared live/backtest rules:
// - finalized bullish open≈low / bearish open≈high 15-minute candle;
// - close versus EMA(50) plus a five-bar EMA slope;
// - signals only from 09:30–13:30 America/New_York;
// - exact limit order at the no-wick candle's opening price;
// - latest confirmed 3-left/3-right pivot plus one tick for the stop;
// - 2R target, one active position, and pending cancellation on trend change.

groupRules = "Strategy"
rewardRisk = input.float(2.0, "Reward / risk", minval = 0.1, step = 0.1, group = groupRules)
toleranceTicks = input.float(
     0.5,
     "Opening-wick tolerance (ticks)",
     minval = 0.0,
     maxval = 2.0,
     step = 0.1,
     group = groupRules
)
emaLength = input.int(50, "EMA length", minval = 2, group = groupRules)
emaSlopeLookback = input.int(5, "EMA slope lookback", minval = 1, group = groupRules)
pivotLeft = input.int(3, "Pivot bars left", minval = 1, group = groupRules)
pivotRight = input.int(3, "Pivot bars right", minval = 1, group = groupRules)
stopBufferTicks = input.int(1, "Stop buffer (ticks)", minval = 0, group = groupRules)
entrySession = input.session("0930-1330", "New York signal session", group = groupRules)
enforceFifteenMinutes = input.bool(true, "Require 15-minute chart", group = groupRules)
enableLongs = input.bool(true, "Enable BUY signals", group = groupRules)
enableShorts = input.bool(true, "Enable SELL signals", group = groupRules)

groupDisplay = "Display"
showEma = input.bool(true, "Plot EMA", group = groupDisplay)
showSignals = input.bool(true, "Plot eligible no-wick signals", group = groupDisplay)
buyColor = input.color(color.rgb(46, 204, 113), "BUY color", group = groupDisplay)
sellColor = input.color(color.rgb(231, 76, 60), "SELL color", group = groupDisplay)

isFifteenMinute = timeframe.isminutes and timeframe.multiplier == 15
if barstate.isfirst and enforceFifteenMinutes and not isFifteenMinute
    runtime.error("No Wick Origin-Limit Strategy requires a 15-minute chart.")

tolerance = syminfo.mintick * toleranceTicks
stopBuffer = syminfo.mintick * stopBufferTicks
emaValue = ta.ema(close, emaLength)
upTrend = close > emaValue and emaValue > emaValue[emaSlopeLookback]
downTrend = close < emaValue and emaValue < emaValue[emaSlopeLookback]
trend = upTrend ? 1 : downTrend ? -1 : 0
inSession = not na(time(timeframe.period, entrySession, "America/New_York"))

pivotLow = ta.pivotlow(low, pivotLeft, pivotRight)
pivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)
var float latestPivotLow = na
var float latestPivotHigh = na
if not na(pivotLow)
    latestPivotLow := pivotLow
if not na(pivotHigh)
    latestPivotHigh := pivotHigh

bullishWickless = barstate.isconfirmed and close > open and open - low <= tolerance
bearishWickless = barstate.isconfirmed and close < open and high - open <= tolerance
buySetup = bullishWickless and upTrend and inSession and enableLongs
sellSetup = bearishWickless and downTrend and inSession and enableShorts

var array<string> pendingIds = array.new_string()
var array<int> pendingTrends = array.new_int()

// Recalculate immediately after a fill and cancel every other pending entry.
// This keeps TradingView aligned with the Python one-position-per-pair rule.
if strategy.position_size != 0 and array.size(pendingIds) > 0
    pendingIndex = array.size(pendingIds) - 1
    while pendingIndex >= 0
        strategy.cancel(array.get(pendingIds, pendingIndex))
        array.remove(pendingIds, pendingIndex)
        array.remove(pendingTrends, pendingIndex)
        pendingIndex -= 1

// Pine evaluates at bar close. Cancelling here removes every still-pending
// origin limit from the prior trend; filled positions and their brackets stay.
if barstate.isconfirmed and trend != trend[1]
    pendingIndex = array.size(pendingIds) - 1
    while pendingIndex >= 0
        pendingId = array.get(pendingIds, pendingIndex)
        pendingTrend = array.get(pendingTrends, pendingIndex)
        if trend != pendingTrend
            strategy.cancel(pendingId)
            array.remove(pendingIds, pendingIndex)
            array.remove(pendingTrends, pendingIndex)
        pendingIndex -= 1

if buySetup and strategy.position_size == 0 and not na(latestPivotLow)
    entryPrice = open
    stopPrice = latestPivotLow - stopBuffer
    risk = entryPrice - stopPrice
    if risk > syminfo.mintick / 2
        targetPrice = entryPrice + rewardRisk * risk
        entryId = "NW-B-" + str.tostring(bar_index)
        exitId = "NW-X-" + str.tostring(bar_index)
        payload = '{"content":"**NO WICK 15m ORIGIN FILL: BUY ' + syminfo.ticker + '**\\n' +
             'Entry limit: `' + str.tostring(entryPrice, format.mintick) + '`\\n' +
             'Stop: `' + str.tostring(stopPrice, format.mintick) + '`\\n' +
             'Target (' + str.tostring(rewardRisk, "#.##") + 'R): `' +
             str.tostring(targetPrice, format.mintick) + '`\\n' +
             'Filter: EMA(' + str.tostring(emaLength) + ') slope ' +
             str.tostring(emaSlopeLookback) + ', pivot ' +
             str.tostring(pivotLeft) + '/' + str.tostring(pivotRight) + '\\n' +
             'Signal session: 09:30–13:30 New York"}'
        strategy.entry(
             entryId,
             strategy.long,
             limit = entryPrice,
             alert_message = payload
        )
        strategy.exit(
             exitId,
             from_entry = entryId,
             stop = stopPrice,
             limit = targetPrice
        )
        array.push(pendingIds, entryId)
        array.push(pendingTrends, 1)

if sellSetup and strategy.position_size == 0 and not na(latestPivotHigh)
    entryPrice = open
    stopPrice = latestPivotHigh + stopBuffer
    risk = stopPrice - entryPrice
    if risk > syminfo.mintick / 2
        targetPrice = entryPrice - rewardRisk * risk
        entryId = "NW-S-" + str.tostring(bar_index)
        exitId = "NW-X-" + str.tostring(bar_index)
        payload = '{"content":"**NO WICK 15m ORIGIN FILL: SELL ' + syminfo.ticker + '**\\n' +
             'Entry limit: `' + str.tostring(entryPrice, format.mintick) + '`\\n' +
             'Stop: `' + str.tostring(stopPrice, format.mintick) + '`\\n' +
             'Target (' + str.tostring(rewardRisk, "#.##") + 'R): `' +
             str.tostring(targetPrice, format.mintick) + '`\\n' +
             'Filter: EMA(' + str.tostring(emaLength) + ') slope ' +
             str.tostring(emaSlopeLookback) + ', pivot ' +
             str.tostring(pivotLeft) + '/' + str.tostring(pivotRight) + '\\n' +
             'Signal session: 09:30–13:30 New York"}'
        strategy.entry(
             entryId,
             strategy.short,
             limit = entryPrice,
             alert_message = payload
        )
        strategy.exit(
             exitId,
             from_entry = entryId,
             stop = stopPrice,
             limit = targetPrice
        )
        array.push(pendingIds, entryId)
        array.push(pendingTrends, -1)

plot(showEma ? emaValue : na, title = "EMA trend", color = color.orange)
plotshape(
     showSignals and buySetup,
     title = "Eligible BUY origin",
     style = shape.labelup,
     location = location.belowbar,
     color = buyColor,
     text = "BUY LIMIT",
     textcolor = color.white,
     size = size.tiny
)
plotshape(
     showSignals and sellSetup,
     title = "Eligible SELL origin",
     style = shape.labeldown,
     location = location.abovebar,
     color = sellColor,
     text = "SELL LIMIT",
     textcolor = color.white,
     size = size.tiny
)
